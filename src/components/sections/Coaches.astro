---
const coaches = [
  { name: "Baptiste Chamodon", role: "Coach sportif", img: "/images/coaches/baptiste-chamodon.jpg" },
  { name: "Activ'Sport", role: "Centre EMS — Villeurbanne", img: "/images/coaches/activsport.avif" },
  { name: "Anthony Fernandez", role: "Coach sportif", img: "/images/coaches/anthony-fernandez.jpg" },
  { name: "Stéphanie Hazebroucq", role: "Coach EMS", img: "/images/coaches/stephanie-hazebroucq.jpg" },
  { name: "Jessica", role: "Coach Fitness", img: "/images/coaches/jessica-coach-fitness.webp" },
  { name: "Jaime Carvalho", role: "Coach sportif", img: "/images/coaches/jaime-carvalho.jpg" },
  { name: "Florian Colotte", role: "Coach sportif", img: "/images/coaches/florian-colotte.jpg" },
  { name: "Geoffrey Darde", role: "Coaching à domicile & entreprise", img: "/images/coaches/geoffrey-darde.avif" },
];

// Quadruple for seamless infinite loop on all screen sizes
const doubled = [...coaches, ...coaches, ...coaches, ...coaches];
const profiles = [
  { label: "Coach sportif", icon: "M3 10v4M6 8v8M18 8v8M21 10v4M6 12h12" },
  { label: "Gérant de salle", icon: "M4 20V10l8-6 8 6v10M9 20v-6h6v6" },
  { label: "Kiné", icon: "M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10zM9.5 11h5M12 8.5v5" },
  { label: "Centre de bien-être", icon: "M5 19c0-8 6-14 14-14 0 8-6 14-14 14zM5 19l7-7" },
  { label: "Studio de Pilates Reformer", icon: "M3 14h18M5 14v4M19 14v4M7 14v-3h10v3M9 11V8" },
];
---

<section id="avis" class="border-b border-border-soft/60 overflow-hidden py-20">
  <div class="mx-auto max-w-7xl px-6 text-center mb-12">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      <span class="brand-gradient-text">+300 professionnels</span> équipés en France
    </h2>
    <div class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-3 sm:flex sm:flex-wrap sm:justify-center sm:gap-4">
      {profiles.map((p) => (
        <div class="fg-card !flex-row items-center gap-3 !p-3 sm:!px-5 sm:!py-4 text-left">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#FDE8E8]">
            <svg viewBox="0 0 24 24" fill="none" stroke="#C8161D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d={p.icon} /></svg>
          </span>
          <span class="fg-title text-base sm:text-lg" style="font-style:normal">{p.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Infinite scroll track -->
  <div class="relative">
    <!-- Fade edges -->
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent" />
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent" />

    <div class="flex gap-4 coaches-track">
      {doubled.map((coach, i) => (
        <div class="flex-shrink-0 w-[180px]" aria-hidden={i >= coaches.length ? "true" : undefined}>
          <!-- Photo -->
          <div class="relative w-full aspect-[3/4] rounded-2xl overflow-hidden border border-border-soft bg-surface-2">
            {coach.img ? (
              <img
                src={coach.img}
                alt={coach.name}
                class="w-full h-full object-cover object-top"
                loading="lazy"
              />
            ) : (
              <!-- Placeholder gradient -->
              <div class="w-full h-full bg-gradient-to-br from-zinc-800 to-zinc-900 flex items-end justify-center pb-6">
                <div class="h-16 w-16 rounded-full bg-gradient-to-br from-zinc-600 to-zinc-700 flex items-center justify-center text-xl font-bold text-zinc-400">
                  {coach.name.charAt(0)}
                </div>
              </div>
            )}
          </div>
          <!-- Name + role -->
          <div class="mt-3 text-center">
            <p class="text-sm font-semibold text-foreground">{coach.name}</p>
            <p class="text-xs text-zinc-500 mt-0.5">{coach.role}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .coaches-track {
    animation: scroll-coaches 30s linear infinite;
    width: max-content;
  }

  .coaches-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-coaches {
    0% { transform: translateX(0); }
    100% { transform: translateX(-25%); }
  }
</style>
