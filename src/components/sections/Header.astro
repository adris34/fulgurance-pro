---
import CtaButton from "@/components/ui/CtaButton.astro";

const navLinks = [
  { label: "Proposez EMS à vos clients", href: "#pourquoi-ems" },
  { label: "Avis clients", href: "#avis" },
  { label: "Application & Séances", href: "#vsl" },
  { label: "Garanties", href: "#garanties" },
  { label: "QVEMA", href: "#qvema" },
  { label: "À Propos", href: "#a-propos" },
];
---

<header class="sticky top-0 z-50 border-b border-border-soft/60 bg-background/80 backdrop-blur-md">
  <div class="relative mx-auto flex max-w-screen-2xl items-center px-6 py-4 lg:px-16">

    <!-- Logo : visible uniquement sur desktop -->
    <a href="/" aria-label="Fulgurance — Accueil" class="hidden lg:block">
      <img
        src="/images/fulgurance-logo.svg"
        alt="Fulgurance"
        width="150"
        height="45"
        class="h-8 w-auto"
        loading="eager"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex flex-1 items-center justify-center gap-6">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-white px-3 py-1.5 rounded-full transition-colors hover:bg-white hover:text-black"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Mobile : burger gauche, logo centre, bouton droite -->
    <button
      id="menu-toggle"
      class="lg:hidden flex flex-col gap-1.5 p-1 mr-auto"
      aria-label="Menu"
    >
      <span class="block h-0.5 w-6 bg-white"></span>
      <span class="block h-0.5 w-6 bg-white"></span>
      <span class="block h-0.5 w-6 bg-white"></span>
    </button>

    <a href="/" aria-label="Fulgurance — Accueil" class="absolute left-1/2 -translate-x-1/2 lg:hidden">
      <img
        src="/images/fulgurance-logo.svg"
        alt="Fulgurance"
        class="h-8 w-auto"
        loading="eager"
      />
    </a>

    <div class="ml-auto flex items-center gap-2">
      <!-- Desktop CTA -->
      <div class="hidden lg:block">
        <CtaButton href="https://cal.eu/fulgurance-pro/decouverte-30min">Votre Démo</CtaButton>
      </div>
      <!-- Mobile CTA -->
      <CtaButton href="https://cal.eu/fulgurance-pro/decouverte-30min" class="lg:hidden !px-4 !py-2 !text-xs">Votre Démo</CtaButton>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border-soft/60 bg-background px-6 py-4">
    <nav class="flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-white px-3 py-1.5 rounded-full transition-colors hover:bg-white hover:text-black"
          data-mobile-link
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  document.querySelectorAll("[data-mobile-link]").forEach((link) =>
    link.addEventListener("click", () => menu?.classList.add("hidden"))
  );
</script>
