---
import CtaButton from "@/components/ui/CtaButton.astro";
import VideoBlock from "@/components/ui/VideoBlock.astro";
---

<section class="relative overflow-hidden border-b border-border-soft/60">
  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 lg:grid-cols-[1fr_1.15fr] lg:py-24">
    <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
    <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-border-soft bg-surface px-4 py-2 text-xs font-medium uppercase tracking-wider text-zinc-300">
      <span class="h-2 w-2 rounded-full brand-gradient" />
      Qui Veut Être Mon Associé : Saison 4 · M6
    </p>

    <div class="mb-6 flex flex-row items-center gap-3">
      <img
        src="/images/coaches-avis.png"
        alt="Coachs utilisant Fulgurance EMS"
        class="h-12 w-auto"
        loading="eager"
      />
      <div class="flex flex-col items-start gap-0.5">
        <span class="text-sm text-zinc-300 tracking-wide">Avis 5/5 ⭐️⭐️⭐️⭐️⭐️</span>
        <span class="text-foreground text-sm sm:text-xl font-normal tracking-wide">Salles de sport, coachs...</span>
      </div>
    </div>

    <h1 class="max-w-xl">
      La technologie EMS<br /><span class="text-[#C8161D]">nouvelle génération</span>
    </h1>
    <p class="fg-title mt-6 text-xl sm:text-2xl" style="font-style:normal">Plus de liberté. Plus de confort. Plus de simplicité.</p>
    <p class="mt-4 max-w-xl text-base text-[#3a3a3a] sm:text-lg">Une expérience musculaire intense, sans les contraintes des technologies traditionnelles.</p>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
      <CtaButton href="https://www.cal.eu/fulgurance-pro/decouverte-30min?month=2026-10&date=2026-10-02" target="_blank" rel="noopener noreferrer">Découvrez nos offres</CtaButton>
      <a href="#vsl" class="text-sm font-medium text-zinc-400 underline-offset-4 hover:text-foreground hover:underline">
        Une liberté de mouvement ↓
      </a>
    </div>

    </div>

    <div class="w-full">
    <div class="w-full">
      <VideoBlock
        youtubeId="f9udAwLgrQw"
        label="Équipez vos clients en quelques secondes et pilotez vos séances de groupe ou individuelles"
        caption="Aucune installation lourde, aucun matériel encombrant : tout se gère en quelques minutes, n'importe où"
      />
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5">
      {["Lavable", "Sans câbles", "Application connectée", "Séance de groupe"].map((item) => (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-[11px] font-medium uppercase tracking-wider text-black">
          <span class="h-1.5 w-1.5 rounded-full brand-gradient" />
          {item}
        </span>
      ))}
    </div>
    </div>
  </div>
</section>
