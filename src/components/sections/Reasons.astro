---
import CtaButton from "@/components/ui/CtaButton.astro";
const reasons = [
  {
    number: "01",
    title: "Nouvelle clientèle",
    text: "Proposez des séances en extérieur, des circuits training et des activités plus dynamiques grâce à la liberté de mouvement sans fil. Étant équipé de la dernière innovation EMS, vous devenez la référence pour vos clients.",
  },
  {
    number: "02",
    title: "Votre CA",
    text: "90% des particuliers sont séduits par l'EMS, vos clients augmentent naturellement leur nombre de séances. Proposer l'EMS justifie aussi un positionnement premium pour un segment client prêt à investir davantage dans vos séances.",
  },
  {
    number: "03",
    title: "Gain de temps",
    text: "Avec Fulgurance EMS, plus besoin d'acheter, laver et gérer des tenues spécifiques. Un centre avec 30 clients par jour économise en moyenne 1h30 de temps d'équipement, vos clients s'équipant seuls. Une économie immédiate sur le matériel et la masse salariale.",
  },
];
---

<section id="pourquoi-ems" class="border-b border-border-soft/60">
  <div class="mx-auto max-w-7xl px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        3 raisons de proposer l&apos;EMS à vos clients
      </h2>
      <p class="mt-4 text-zinc-400">
        Proposer l&apos;EMS est un véritable levier de développement pour votre activité.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {reasons.map((reason) => (
        <div class="rounded-2xl border border-border-soft bg-surface p-6 transition-colors hover:border-fulgurance-red/50">
          <span class="text-sm font-mono font-semibold brand-gradient-text">{reason.number}</span>
          <h3 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{reason.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">{reason.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-center gap-3">
      <CtaButton href="https://cal.eu/fulgurance-pro/decouverte-30min">Découvrez maintenant</CtaButton>
      <p class="text-zinc-400 text-center">Un membre de l'équipe vous explique le fonctionnement de notre technologie pour répondre à vos besoins</p>
    </div>
  </div>
</section>
