---
import CtaButton from "@/components/ui/CtaButton.astro";
---

<footer class="bg-surface/40">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-16 text-center">
    <img src="/images/fulgurance-logo.svg" alt="Fulgurance" width="140" height="42" class="h-7 w-auto" />
    <h2 class="max-w-md text-xl font-semibold">
      Prêt à transformer votre centre avec la technologie Fulgurance ?
    </h2>
    <CtaButton href="https://www.cal.eu/fulgurance-pro/decouverte-30min?month=2026-10&date=2026-10-02" target="_blank" rel="noopener noreferrer">Réservez une Démo</CtaButton>
  </div>
  <div class="border-t border-border-soft/40">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-6 py-5 text-xs text-zinc-600 sm:flex-row">
      <span>Fulgurance SAS · 10 rue Mohamed V, 34080 Montpellier</span>
      <div class="flex items-center gap-4">
        <a href="https://wa.me/33000000000" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-400 underline underline-offset-2">WhatsApp</a>
        <a href="/mentions-legales" class="hover:text-zinc-400 underline underline-offset-2">Mentions légales</a>
      </div>
    </div>
  </div>
</footer>
