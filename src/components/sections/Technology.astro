---
const stats = [
  { number: "100 %", label: "Confort maximal", desc: "Sans fil, sans câble, sans scratch" },
  { number: "20", label: "Électrodes", desc: "Réparties sur les zones musculaires du corps" },
  { number: "0", label: "Humidification", desc: "Des électrodes sèches, prêtes à l'emploi" },
  { number: "3 min", label: "Installation", desc: "On enfile, on connecte, on s'entraîne" },
];

const features = [
  { icon: "M13 4a1 1 0 1 0 2 0 1 1 0 0 0-2 0M7 21l3-4 2 2 1-5 3 2v-4l-3-2-3 1-2 4", label: "Liberté de mouvement", desc: "Totale, pendant toute la séance" },
  { icon: "M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z", label: "Hygiène optimale", desc: "Combinaison lavable en machine" },
  { icon: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z", label: "Aucune limite", desc: "En intérieur comme en extérieur" },
  { icon: "M13 2 4 14h7l-1 8 9-12h-7l1-8z", label: "Puissance et intensité", desc: "Un ressenti musculaire renforcé" },
];
---

<section class="fg-light py-20 lg:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-12 text-center">
      <p class="fg-eyebrow">Nouvelle génération</p>
      <h2 class="fg-title text-5xl sm:text-6xl">
        La technologie <span class="text-[#C8161D]">Fulgurance</span>
      </h2>
      <p class="mt-3 text-[#3a3a3a]">Tout ce qu'il faut pour une séance intense, sans les contraintes.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class="fg-card">
          <span class="fg-index">{String(i + 1).padStart(2, "0")}</span>
          <p class="fg-title text-5xl text-[#C8161D]">{s.number}</p>
          <p class="fg-title mt-2 text-xl not-italic">{s.label}</p>
          <p class="mt-3 text-sm text-[#3a3a3a]">{s.desc}</p>
        </div>
      ))}
      {features.map((f, i) => (
        <div class="fg-card">
          <span class="fg-index">{String(i + 5).padStart(2, "0")}</span>
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#FDE8E8]">
            <svg viewBox="0 0 24 24" fill="none" stroke="#C8161D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d={f.icon} /></svg>
          </span>
          <p class="fg-title mt-4 text-xl not-italic">{f.label}</p>
          <p class="mt-3 text-sm text-[#3a3a3a]">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
