---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Fulgurance Pro — Équipez votre centre avec l'EMS nouvelle génération",
  description = "Salles de sport, écoles sportives, coachs : équipez votre structure avec la technologie d'électrostimulation Fulgurance, conçue et fabriquée en France. Réservez votre appel découverte (sans engagement).",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/images/fulgurance-logo.svg", Astro.site);

// Données structurées schema.org : aident à la fois le SEO classique (Google)
// et la compréhension du contenu par les moteurs/agents IA (LLM, "AEO/GEO").
const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Fulgurance",
  url: Astro.site?.toString(),
  logo: ogImageURL.toString(),
  description:
    "Fulgurance conçoit et fabrique en France des équipements professionnels d'électrostimulation (EMS) — combinaisons connectées et générateurs — pour les salles de sport, écoles sportives, clubs et coachs.",
  areaServed: "FR",
  knowsAbout: [
    "Électrostimulation musculaire (EMS)",
    "Équipement professionnel pour salles de sport",
    "Combinaison EMS connectée",
    "Générateur EMS sans fil",
  ],
};

const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Fulgurance PowerSuit & Générateur ProPulse",
  brand: { "@type": "Brand", name: "Fulgurance" },
  description:
    "Solution professionnelle d'électrostimulation pour salles de sport, écoles sportives et coachs : combinaison PowerSuit sans fil et générateur ProPulse, pilotables via l'application Fulgurance pour des séances individuelles ou collectives.",
  audience: {
    "@type": "BusinessAudience",
    audienceType: "Salles de sport, centres EMS, écoles sportives, coachs sportifs professionnels",
  },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Pourquoi un appel est-il nécessaire avant de commander ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Chaque centre, chaque école et chaque coach a des besoins différents (nombre de générateurs, de combinaisons, accompagnement). L'appel permet de comprendre l'activité et de proposer la configuration la plus adaptée, sans engagement.",
      },
    },
    {
      "@type": "Question",
      name: "Quels sont les délais de livraison de Fulgurance ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Fulgurance est une entreprise française avec des délais rapides et maîtrisés, communiqués lors de l'appel découverte selon la configuration retenue.",
      },
    },
    {
      "@type": "Question",
      name: "Qu'est-ce qui est inclus dans l'accompagnement Fulgurance ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Tous les packs Fulgurance incluent une formation complète à l'utilisation du matériel et des programmes, une assurance avec remplacement du générateur sous 24h, ainsi qu'un service après-vente réactif.",
      },
    },
    {
      "@type": "Question",
      name: "La technologie Fulgurance est-elle adaptée à mon type de structure ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Salles de sport, centres EMS, écoles sportives, clubs et coachs indépendants : la technologie Fulgurance s'adapte à différents formats d'encadrement, individuels comme collectifs.",
      },
    },
  ],
};
---

<!doctype html>
<html lang="fr" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/images/fulgurance-logo.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Fulgurance" />
    <meta name="language" content="fr" />

    <!-- Open Graph / réseaux sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fulgurance Pro" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Meta Pixel -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '837162387870629');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=837162387870629&ev=PageView&noscript=1" />
    </noscript>

    <!-- Données structurées schema.org : aident le SEO et la compréhension du
         contenu de la page par les agents/LLM (recherche IA, ChatGPT, Perplexity…) -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </head>
  <body class="min-h-full flex flex-col bg-background text-foreground">
    <slot />
  <!-- WhatsApp floating button -->
  <a
    href="https://wa.me/33687784426?text=Bonjour%20Fran%C3%A7ois%2C%20j%27ai%20une%20question"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contacter Fulgurance sur WhatsApp"
    class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] shadow-lg transition-transform hover:scale-110"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="h-7 w-7">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.122 1.528 5.857L.057 23.885a.5.5 0 0 0 .609.609l6.101-1.476A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.006-1.376l-.36-.213-3.624.877.893-3.533-.234-.372A9.818 9.818 0 1 1 12 21.818z"/>
    </svg>
  </a>

  </body>
</html>
